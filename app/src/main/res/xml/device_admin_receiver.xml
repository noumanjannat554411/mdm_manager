<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies>
        <!-- Password Policies -->
        <limit-password />
        <watch-login />
        <reset-password />
        <expire-password />
        
        <!-- Device Control -->
        <force-lock />
        <wipe-data />
        
        <!-- Hardware Control -->
        <disable-camera />
        <disable-keyguard-features />
        
        <!-- Encryption -->
        <encrypted-storage />
        
        <!-- User Restrictions -->
        <disable-keyguard-widgets />
        
        <!-- Network and Security -->
        <set-global-proxy />
    </uses-policies>
</device-admin>
